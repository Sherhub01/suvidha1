# ── Runtime ────────────────────────────────────────────────
# Must be "production" on any deployed environment.
NODE_ENV=development
PORT=5000

# ── Database ───────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/suvidha1

# ── Auth ───────────────────────────────────────────────────
# Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# ── Allowed frontend origins (exact, no trailing slash) ────
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# ── First super admin ──────────────────────────────────────
# Created on first boot only. Leave SEED_ADMIN_PASSWORD empty to have a random
# password generated and printed once to the server log.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=

# ── Email (Gmail app password, not your account password) ──
EMAIL_USER=
EMAIL_PASS=

# ── Cloudinary (gallery uploads) ───────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payments (optional; without these, bookings are cash-only) ──
# Dashboard -> Settings -> API Keys. Use rzp_test_* keys while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks. Point it at
#   https://<your-api>/api/payments/webhook
# and subscribe to payment.captured, payment.failed and refund.processed.
# Without this, a customer who closes the tab mid-payment is never reconciled.
RAZORPAY_WEBHOOK_SECRET=

# ── AI assistant (optional; Groq is tried first) ───────────
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Development only ───────────────────────────────────────
# Writes OTPs to the server log when SMTP is unavailable.
# Ignored when NODE_ENV=production. OTPs are never returned by the API.
OTP_DEBUG_MODE=false
